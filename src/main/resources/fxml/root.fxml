<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/9.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.xin.controller.RootController">
    <top>
        <VBox>
            <MenuBar>
                <Menu text="帮助" onAction="#openLogFiles">
                    <MenuItem text="查看日志" onAction="#openLogFiles"/>
                    <MenuItem text="提需求/bug" onAction="#openIssues"/>
                </Menu>
            </MenuBar>

        </VBox>
    </top>
    <center>
        <SplitPane fx:id="splitPane" dividerPositions="0.2" focusTraversable="" nodeOrientation="LEFT_TO_RIGHT" prefHeight="549.0"
                   prefWidth="1005.0">
            <items>
                <HBox fx:id="leftWrapper" fillHeight="true">
                    <VBox fx:id="activityBar" alignment="TOP_CENTER" minWidth="36" prefWidth="36" maxWidth="36"
                          style="-fx-background-color: #3c3f41; -fx-padding: 5;">
                        <Button fx:id="toggleLeftPaneBtn" minWidth="28" prefWidth="28" maxWidth="28" prefHeight="28" onAction="#toggleLeftPane"
                                style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 14px; -fx-padding: 0;" text="☰"/>
                    </VBox>
                    <BorderPane fx:id="leftPane" maxHeight="1.7976931348623157E308" maxWidth="300.0" minWidth="0" prefHeight="200.0"
                                prefWidth="200.0" HBox.hgrow="ALWAYS">
                        <center>
                            <ZkConfListView fx:id="zkConfListView" prefHeight="495.0" prefWidth="230.0"
                                            BorderPane.alignment="CENTER"/>
                        </center>
                        <top>
                            <HBox alignment="CENTER" fillHeight="true">
                                <SearchTextField fx:id="filterTextField" minWidth="0" promptText="Search"
                                                 HBox.hgrow="ALWAYS" BorderPane.alignment="CENTER"/>
                                <Button minWidth="32" prefWidth="32" maxWidth="32" onAction="#addNewConnect"
                                        style="-fx-background-image:  url(icons/add.png);-fx-background-repeat: stretch; -fx-background-position: center center; ;"/>
                            </HBox>
                        </top>
                    </BorderPane>
                </HBox>

                <BorderPane>
                    <center>
                        <TabPane fx:id="connectTabPane" prefHeight="200.0" prefWidth="200.0"
                                 tabClosingPolicy="SELECTED_TAB">
                            <Tab text="介绍页" closable="false">
                                <BorderPane>
                                    <center>
                                        <HyperlinkLabel style="-fx-font-size: 15px" fx:id="welcomeInfo"
                                                        text="zookeeper-visualizer是zookeeper的可视化管理工具"></HyperlinkLabel>
                                    </center>
                                </BorderPane>
                            </Tab>
                        </TabPane>
                    </center>
                </BorderPane>
            </items>
        </SplitPane>
    </center>
